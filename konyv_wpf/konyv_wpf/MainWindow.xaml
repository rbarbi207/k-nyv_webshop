<Window x:Class="konyv_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:konyv_wpf"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" SizeChanged="Window_SizeChanged"
        Name="window" PreviewKeyDown="Window_PreviewKeyDown"
        Title="MainWindow">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml"/>

    </Window.Resources>
    <Grid Margin="20,20,10,0" x:Name="windowGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="25*" />
        </Grid.ColumnDefinitions>


        <!--  Háttér  -->
        <Rectangle Style="{StaticResource rct_background}">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF49466D" Offset="0"/>
                    <GradientStop Color="#FFBBBBBB" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Image Style="{StaticResource img_background}"/>



        <!-- Header - Title, Icon, Language -->
        <Label Name="h1"  Content="{DynamicResource Title}" Style="{StaticResource h1}" />

        <TextBlock x:Name="book" Style="{StaticResource logo}"/>

        <Grid HorizontalAlignment="Right" Grid.Column="2" x:Name="language">
            <TextBlock Name="txtb_lang" Style="{StaticResource languageButton}"
                       MouseEnter="txtb_lang_MouseEnter" MouseLeave="txtb_lang_MouseLeave" MouseDown="txtb_lang_MouseDown"/>

            <Label Name="lbl_lang" Content="{DynamicResource LangLabel}" Background="{x:Null}" Style="{StaticResource lngLbl }"
                   MouseEnter="lbl_lang_MouseEnter" MouseLeave="lbl_lang_MouseLeave" MouseDown="lbl_lang_MouseDown"/>
        </Grid>




        <!-- Searchbar, Update, Listbox -->
        <Grid x:Name="contentArea" Style="{StaticResource searchbarGrid}" >
            <Rectangle x:Name="rct_list" Style="{StaticResource rct_list_Style}" />

            <TextBox x:Name="tbx_searchbar" Style="{StaticResource searchbarStyle}" FocusVisualStyle="{x:Null}"  SelectionBrush="{x:Null}" SelectionTextBrush="{x:Null}"  Background="{x:Null}" BorderBrush="{x:Null}"   
                     TextChanged="tbx_searchbar_TextChanged" GotKeyboardFocus="tbx_searchbar_GotKeyboardFocus" KeyDown="tbx_searchbar_KeyDown"  />
            <TextBlock Style="{StaticResource searchIcon}" />
            <TextBlock  Name="img_sort" Style="{StaticResource sortIcon}"
                       MouseEnter="Image_MouseEnter" MouseLeave="img_sort_MouseLeave" MouseDown="img_sort_MouseDown" />
            <Rectangle x:Name="rectangle" Style="{StaticResource rct_box}"/>

            <Border Style="{StaticResource rct_border}">
                <ListBox x:Name="lbx_books" Style="{StaticResource lbx_books_style}" BorderBrush="{x:Null}" SelectionChanged="lbx_books_SelectionChanged">

                    <ListBox.ItemContainerStyle >

                        <Style TargetType="{x:Type ListBoxItem}" >
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1d152e"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="1"        >
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFEDEDED"/>
                                                <Setter Property="Foreground" Value="#FF827690"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFA190BF"/>
                                                <Setter Property="Foreground" Value="#FF32253C"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFA190BF"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>

                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>


        <!-- Form -->
        <ScrollViewer Style="{StaticResource formscroll}">
            <StackPanel x:Name="panelRight" Margin="0,0,10,0">
                <Grid>
                    <!-- titlesearch -->
                    <Rectangle Name="rct_title" Style="{StaticResource field}" />
                    <Label Content="{DynamicResource LblTitle}" Margin="10,5,0,0" FontWeight="Bold"/>
                    <TextBox Name="txtTitle"  Style="{StaticResource form_text}" TextChanged="txtTitle_TextChanged" Margin="45,0,28,0" VerticalAlignment="Center"  />
                    <TextBlock Name="tick1" Style="{StaticResource tick}"/>
                </Grid>

                <Grid Style="{StaticResource gridform}">
                    <!-- authorsearch -->
                    <Rectangle Name="rct_author" Style="{StaticResource field}" />
                    <Label  Content="{DynamicResource LblAuthor}" Margin="10,5,0,0" FontWeight="Bold"/>
                    <TextBox Name="txtAuthor" Style="{StaticResource form_text}"  VerticalAlignment="Top" Margin="60,9,30,0" 
                             TextChanged="txtAuthor_TextChanged"/>
                    <TextBlock Name="tick2" Style="{StaticResource tick}"/>
                </Grid>

                <Grid Style="{StaticResource gridform}">
                    <!-- genresearch -->
                    <Rectangle Name="rct_genre" Style="{StaticResource rct_genre_style}"/>
                    <Label Content="{DynamicResource LblGenre}" Margin="10,5,0,0" FontWeight="Bold"/>
                    <ComboBox Style="{StaticResource MyComboBoxStyle}" Name="cmbGenre" SelectionChanged="cmbGenre_SelectionChanged" />
                    <Label Content="{DynamicResource LblNewGenre}" Margin="10,45,30,0" FontWeight="Bold"/>
                    <TextBox Name="txtGenre" Style="{StaticResource form_text}" Margin="80,50,40,10" Height="20" TextWrapping="Wrap" 
                             TextChanged="txtGenre_TextChanged" />
                    <TextBlock Name="tick0" Style="{StaticResource tick}"/>
                </Grid>

                <Grid Style="{StaticResource gridform}">
                    <!-- publishersearch -->
                    <Rectangle Name="rct_publisher" Style="{StaticResource field}" />
                    <Label Content="{DynamicResource LblPublisher}" Margin="10,5,30,0" FontWeight="Bold"/>
                    <TextBox Name="txtPublisher" Style="{StaticResource form_text}" Margin="70,9,40,7" Height="20" TextWrapping="Wrap" 
                             TextChanged="txtPublisher_TextChanged"/>
                    <TextBlock  Name="tick3" Style="{StaticResource tick}"/>
                </Grid>

                <Grid Style="{StaticResource gridform}">
                    <!-- ebook/paperSearch -->
                    <Rectangle Style="{StaticResource field}"  Name="rct_ebook" />
                    <RadioButton Name="rad_ebook" Style="{StaticResource rb_form}" HorizontalAlignment="Left" Margin="20,10,0,0" Content="{DynamicResource RbEbook}" Checked="rad_ebook_Checked" />
                    <RadioButton Name="rad_paper" Style="{StaticResource rb_form}" HorizontalAlignment="Right" Margin="0,10,20,0" Content="{DynamicResource RbPaper}" Checked="rad_paper_Checked" />
             
                </Grid>
                <Grid Style="{StaticResource gridform}">
                    <!-- DateSearch -->
                    <Rectangle Name="rct_Date" Style="{StaticResource field}" />
                    <Label Content="{DynamicResource LblDate}" Height="33" Margin="10,5,0,0" FontWeight="Bold"/>
                    <DatePicker Name="dpDate" Style="{StaticResource datepicker_form}"
                        SelectedDateChanged="dpDate_SelectedDateChanged" DisplayDateEnd="{Binding Mode=OneWay, Source={x:Static System:DateTime.Today}}"/>
                </Grid>
                <Grid Style="{StaticResource gridform}">
                    <!-- NationalitySearch -->
                    <Rectangle Name="rct_national" Style="{StaticResource field}" />
                    <Label Content="{DynamicResource LblNationality}" Height="33" Margin="10,5,0,0" FontWeight="Bold"/>
                    <TextBox Name="txtnational" Style="{StaticResource form_text}" Margin="90,9,30,9" Height="20" TextWrapping="Wrap"
                             TextChanged="txtNatioal_TextChanged" />
                    <TextBlock Name="tick4" Style="{StaticResource tick}"/>
                </Grid>
                <Grid Style="{StaticResource gridform}">
                    <!-- CopySearch -->
                    <Rectangle Name="rct_copy" Style="{StaticResource field}" />
                    <Label Content="{DynamicResource LblCopy}" Height="33" Margin="10,5,0,0" FontWeight="Bold"/>
                    <TextBox Name="txtcopy" Style="{StaticResource form_text}" Margin="100,9,30,9" TextWrapping="Wrap" Height="20" 
                             TextChanged="txtCopy_TextChanged" IsEnabled="False"/>
                    <TextBlock Name="tick5" Style="{StaticResource tick}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>


        <!-- EroorMsg -->
        <Grid Grid.Row="2" Height="160">
            <Rectangle Name="rct_error" Style="{StaticResource rctStyleError}"/>
            <Border Name="border_error" Style="{StaticResource borderError}">
                <ScrollViewer VerticalScrollBarVisibility="auto">
                    <TextBlock Name="errorMsg" Style="{StaticResource errorMsgStyle}"/>
                </ScrollViewer>
            </Border>
        </Grid>


        <!-- Button -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Border Name="br_Cancel" Visibility="Hidden" Style="{StaticResource HoverBorder}"  Margin="0,0,140,20"  Width="98" Background="#FF49466D" MouseDown="CancelButton_Click">
                <Button Name="cancelButton"  Content="{DynamicResource BtnCancel}"  Style="{StaticResource functionButton}"
               Width="89" Margin="0,0,0,0" 
                BorderBrush="#FF49466D" Background="#FF49466D"  Height="39" Click="CancelButton_Click"/>
            </Border>
            <Border Name="br_Save"  Style="{StaticResource HoverBorder}" Margin="0,0,10,20"  Width="118" Background="#444455"  MouseDown="SaveButton_Click">
                <Button Name="SaveButton" Style="{StaticResource functionButton}"  Content="{DynamicResource BtnSave}" 
                 Width="89"  BorderBrush="#444455" Padding="5" 
                Background="#444455"   Click="SaveButton_Click"/>
            </Border>
            <Border Name="br_newBook"  Style="{StaticResource HoverBorder}"  Margin="0,0,10,20"  Width="50" Background="#FF403C40" MouseDown="PlusButton_Click">
                <Button Name="PlusButton" Style="{StaticResource functionButton}"  Content="+"  Width="45" 
                Grid.Row="4"  BorderBrush="#FF403C40" Background="#FF403C40" 
             FontFamily="Bodoni MT Black" FontWeight="Bold" Height="35" Click="PlusButton_Click"/>
            </Border>
            <Border x:Name="br_Clear" Style="{StaticResource HoverBorder}"   Width="80"
            Margin="0,0,245,20"  Background="#FF49466D" MouseDown="br_Clear_MouseDown">
                <Button Name="ClearButton" Style="{StaticResource functionButton}"  Content="{DynamicResource BtnClear}" 
                Width="75"  BorderBrush="#FF49466D" Background="#FF49466D" 
                 FontFamily="Arial"  Height="34" Click="br_Clear_MouseDown"/>
            </Border>
            <Border Name="br_Modify"   Style="{StaticResource HoverBorder}" Margin="0,0,145,20" Width="95"
            Background="#FF403C40" MouseDown="br_Modify_MouseDown" >
                <Button Name="ModifyButton"  Content="{DynamicResource BtnModify}" Style="{StaticResource functionButton}"
                Width="90"  BorderBrush="#FF403C40" Background="#FF403C40" 
                FontFamily="Arial" Height="35" Click="br_Modify_MouseDown"/>
            </Border>
            <Border Name="br_Delete"   Style="{StaticResource HoverBorder}"   
            Margin="0,0,65,20"  Width="75" Background="#FF412258" MouseDown="br_Delete_MouseDown" >
                <Button Name="DeleteButton"  Content="{DynamicResource BtnDelete}" Style="{StaticResource functionButton}"
                Width="66"  BorderBrush="#FF412258" Background="#FF412258" 
                FontFamily="Arial"  Height="35" Click="br_Delete_MouseDown"/>
            </Border>
        </Grid>


        <Rectangle Style="{StaticResource rctStyle}"/>

        <!-- PopUp -->
        <Popup x:Name="MyPopup" Style="{StaticResource popUpStyle}">
            <Border Style="{StaticResource popupBorder}">
                <StackPanel>
                    <Button Style="{StaticResource popupButton}" Click="ClosePopup_Click"/>
                    <TextBlock x:Name="PopupText" Text="{DynamicResource RUSure}" Style="{StaticResource popupText}"/>
                    <StackPanel Style="{StaticResource spStyle}">
                        <Button Content="{DynamicResource Yes}" Click="PopupOk_Click" Margin="10,0,10,0" Style="{StaticResource choiceButton}" />
                        <Button Content="{DynamicResource No}" Click="PopupCancel_Click" Style="{StaticResource choiceButton}"  />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MyPopupModify" Style="{StaticResource popUpStyle}">
            <Border Style="{StaticResource popupBorder}">
                <StackPanel>
                    <Button Style="{StaticResource popupButton}" Click="ClosePopup_Click"/>
                    <TextBlock x:Name="PopupTextModifyRUS" Text="{DynamicResource RUSureModify}" Style="{StaticResource popupText}"/>
                    <StackPanel Style="{StaticResource spStyle}">
                        <Button Content="{DynamicResource YesModify}" Click="PopupOk_ClickModifyRUS" Margin="10,0,10,0" Style="{StaticResource choiceButton}" />
                        <Button Content="{DynamicResource NoModify}" Click="PopupCancel_ClickModifyRUS" Style="{StaticResource choiceButton}"  />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MyPopupNew" Style="{StaticResource popUpStyle}">
            <Border Style="{StaticResource popupBorder}">
                <StackPanel>
                    <Button Style="{StaticResource popupButton}" Click="ClosePopup_Click"/>
                    <TextBlock x:Name="PopupTextNewRUS" Text="{DynamicResource RUSureNew}" Style="{StaticResource popupText}"/>
                    <StackPanel Style="{StaticResource spStyle}">
                        <Button Content="{DynamicResource YesNew}" Click="PopupOk_ClickNewRUS" Margin="10,0,10,0" Style="{StaticResource choiceButton}" />
                        <Button Content="{DynamicResource NoNew}" Click="PopupCancel_ClickNewRUS" Style="{StaticResource choiceButton}"  />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="AlreadyExists" Style="{StaticResource popUpStyle}">
            <Border Style="{StaticResource popupBorder}">
                <StackPanel>
                    <Button Style="{StaticResource popupButton}" Click="ClosePopup_Click"/>
                    <TextBlock x:Name="PopupTextNoGenre" Text="{DynamicResource Exists}" Style="{StaticResource popupText}"/>
                    <StackPanel Style="{StaticResource spStyle}">
                        <Button Content="{DynamicResource YesExists}" Click="PopupOk_ClickExists" Margin="10,0,10,0" Style="{StaticResource choiceButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="GenreEnglish" Style="{StaticResource popUpStyle}">
            <Border Style="{StaticResource popupBorder}">
                <StackPanel>
                    <Button Style="{StaticResource popupButton}" Click="ClosePopup_Click"/>
                    <TextBlock x:Name="GenreEnglishText" Text="{DynamicResource GenreEnglish}" Style="{StaticResource popupText}"/>
                    <StackPanel Style="{StaticResource spStyle}">
                        <Button Content="{DynamicResource YesGenreEnglish}" Click="PopupOk_ClickGenreEn" Margin="10,0,10,0" Style="{StaticResource choiceButton}" />
                        <Button Content="{DynamicResource NoGenreEnglish}" Click="PopupNo_ClickGenreEn" Margin="10,0,10,0" Style="{StaticResource choiceButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="4">
            <Border x:Name="ToastPopUp" Style="{StaticResource ToastPopUp}">
                <TextBlock x:Name="ToastText" Style="{StaticResource ToastText}"/>
            </Border>
        </Grid>
    </Grid>
</Window>